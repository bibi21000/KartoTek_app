# À copier vers /opt/kartotek_vault/api.env sur le serveur
KV_MASTER_KEY_FILE=/run/secrets/master.key
KV_DB_PATH=/data/secrets.db
KV_CLIENTS_FILE=/run/secrets/api_clients.json
# Niveaux de clés (optionnel : niveaux par défaut guest/basic/premium/gold si absent)
KV_LEVELS_FILE=/run/secrets/api_levels.json

# Serveurs situés derrière la passerelle
KV_SIMPOSTCARDS_URL=http://simpostcards:8004
KV_FLPOSTCARDS_URL=http://flpostcards:5000
# Réservé (niveau gold) : aucun serveur de sauvegarde n'existe encore => 501
#KV_BACKUP_URL=
# Préfixes sync_url_prefix côté serveurs (valeurs par défaut)
#KV_FLPOSTCARDS_SYNC_PREFIX=/api/v1/sync
#KV_SIMPOSTCARDS_SYNC_PREFIX=/sync/v1
# Délai max d'une réponse d'upstream (s) et taille max d'un corps de requête (Mo)
#KV_UPSTREAM_TIMEOUT=120
#KV_MAX_BODY_MB=32

# Sites flpostcards rattachés aux clés (clé -> "site": "nom") : upstream + mesure du disque
KV_SITES_FILE=/run/secrets/api_sites.json

# Compteurs d'appels et demandes de clé (base distincte du coffre de secrets)
KV_STATS_DB_PATH=/data/gateway.db
# Page publique /request-key
#KV_REQUESTS_ENABLED=true
#KV_REQUEST_RATE_PER_HOUR=3
#KV_REQUESTS_MAX_PENDING=200
# true seulement derrière un reverse proxy de confiance (nginx) qui pose X-Forwarded-For
#KV_TRUST_FORWARDED_FOR=false
