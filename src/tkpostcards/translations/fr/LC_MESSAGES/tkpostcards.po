#: src/tkpostcards/__init__.py:179
msgid ""
"Torch device to use for similarity search (see \"tktools devices\"). "
"Defaults to the [DEFAULT] torch_device setting in the configuration file,"
" or torch's own default (cuda if available, else cpu) if unset."
msgstr ""

#: src/tkpostcards/__init__.py:183
msgid ""
"URI of a remote simpostcards server (e.g. http://simpostcards:8004) used "
"to delegate, instead of a local computation, whatever simpostcards can do"
" in place of this machine: similarity/doubles search and index building "
"(no torch/open-clip-torch/imagehash needed here), travel route "
"optimization (no ortools needed here), and OCR text extraction (no "
"pytesseract/tesseract-ocr needed here). Defaults to the [DEFAULT] "
"external_helper setting in the configuration file, or unset (local "
"computation, those libs required) if neither is given."
msgstr ""

#: src/tkpostcards/__init__.py:193
msgid ""
"Timeout, in seconds, for a single request to --external-helper, before "
"giving up client-side. Defaults to the [DEFAULT] external_helper_timeout "
"setting in the configuration file, or each command's own built-in default"
" (30-60s) if neither is given. Raise this if the remote server has to "
"fall back to cpu for a computation normally done on GPU, which can easily"
" take longer than the default."
msgstr ""

