#: src/tkpostcards/scripts/tktools.py:943
msgid "Redo transparent on postcards"
msgstr "Повторити прозорість на листівках"

#: src/tkpostcards/scripts/tktools.py:946
msgid ""
"Name of the import profile (\"profil d'import\") whose transparency "
"settings should be used (white threshold, band, contour detection). "
"Defaults to the [tkimport] scan_profile setting in the configuration "
"file, or \"cpa\" if unset. See also \"tktools scan profiles\"."
msgstr ""
"Назва профілю імпорту («profil d'import»), параметри прозорості якого "
"слід використати (поріг білого, смуга, визначення контуру). За "
"замовчуванням — параметр scan_profile у [tkimport] конфігураційного "
"файлу, а якщо його не задано — \"cpa\". Див. також \"tktools scan "
"profiles\"."

#: src/tkpostcards/scripts/tktools.py:971
#, python-brace-format
msgid ""
"Profile {name!r} does not apply background transparency "
"(skip_processing/skip_transparency); pick another profile."
msgstr ""
"Профіль {name!r} не застосовує прозорість тла "
"(skip_processing/skip_transparency); виберіть інший профіль."

#: src/tkpostcards/scripts/tktools.py:1018
msgid "Calculate travels and add them to database"
msgstr "Обчислити маршрути та додати їх до бази даних"

#: src/tkpostcards/scripts/tktools.py:1027
msgid "Publish data to a remote web server"
msgstr "Опублікувати дані на віддаленому веб-сервері"

#: src/tkpostcards/scripts/tktools.py:1029
msgid "Update all data (travel, ...) before publishing"
msgstr "Оновити всі дані (подорожі тощо) перед публікацією"

#: src/tkpostcards/scripts/tktools.py:1036
msgid "Give me a config"
msgstr "Вкажіть конфігурацію"

#: src/tkpostcards/scripts/tktools.py:1043
msgid "Fix non-reciprocal double relations between cards"
msgstr "Виправити нереципрокні зв'язки дублікатів між картками"

#: src/tkpostcards/scripts/tktools.py:1044
msgid "Do not update files"
msgstr "Не оновлювати файли"

#: src/tkpostcards/scripts/tktools.py:1156
msgid "Masks (stamps, borders) to feed pycolmap"
msgstr "Маски (марки, краї) для pycolmap"

#: src/tkpostcards/scripts/tktools.py:1162
msgid ""
"Generate masks: SAM detects stamps on the recto, the transparent "
"background and the card border are masked too. Masks edited by hand in "
"ktmanager are never overwritten unless --force-manual."
msgstr ""
"Створити маски: SAM знаходить марки на лицьовій стороні; прозоре тло та "
"край листівки також маскуються. Маски, змінені вручну в ktmanager, ніколи"
" не перезаписуються без --force-manual."

#: src/tkpostcards/scripts/tktools.py:1169
msgid "R = recto (default), V = verso"
msgstr "R = лицьовий бік (за замовчуванням), V = зворотний бік"

#: src/tkpostcards/scripts/tktools.py:1171
msgid "Regenerate existing automatic masks"
msgstr "Створити заново наявні автоматичні маски"

#: src/tkpostcards/scripts/tktools.py:1173
msgid "Also overwrite masks edited by hand"
msgstr "Також перезаписувати маски, змінені вручну"

#: src/tkpostcards/scripts/tktools.py:1175
msgid ""
"Skip stamp detection: only mask the transparent background and the border"
" (fast, no torch needed)"
msgstr ""
"Пропустити виявлення марок: маскувати лише прозоре тло та край (швидко, "
"torch не потрібен)"

#: src/tkpostcards/scripts/tktools.py:1178
msgid ""
"Hugging Face SAM model. Defaults to [masks] sam_model, or facebook/sam-"
"vit-base. Ignored with an external helper: the server's "
"segment_model_name applies."
msgstr ""
"Модель SAM з Hugging Face. За замовчуванням — sam_model у [masks] або "
"facebook/sam-vit-base. Ігнорується із зовнішнім сервером: діє "
"segment_model_name сервера."

#: src/tkpostcards/scripts/tktools.py:1182
msgid ""
"Run SAM here even if an external helper is configured ([DEFAULT] "
"external_helper or --external-helper)"
msgstr ""
"Виконувати SAM тут, навіть якщо налаштовано зовнішній сервер ([DEFAULT] "
"external_helper або --external-helper)"

#: src/tkpostcards/scripts/tktools.py:1198
#, python-brace-format
msgid "SAM computed by {helper}"
msgstr "SAM обчислено на {helper}"

# --- masks (COLMAP) ---
#: src/tkpostcards/scripts/tktools.py:1200
msgid "Masks"
msgstr "Маски"

#: src/tkpostcards/scripts/tktools.py:1206
#, python-brace-format
msgid "{n} stamp(s)"
msgstr "марок: {n}"

#: src/tkpostcards/scripts/tktools.py:1223
#, python-brace-format
msgid ""
"{done} generated, {skipped} skipped, {missing} without image, {error} "
"failed"
msgstr ""
"{done} створено, {skipped} пропущено, {missing} без зображення, {error} з"
" помилками"

#: src/tkpostcards/scripts/tktools.py:1227
msgid "How many cards have a mask"
msgstr "Скільки листівок мають маску"

#: src/tkpostcards/scripts/tktools.py:1240
#, python-brace-format
msgid "{n} cards: {a} automatic, {m} manual, {x} without mask"
msgstr "{n} листівок: {a} автоматичних, {m} ручних, {x} без маски"

#: src/tkpostcards/scripts/tktools.py:1244
msgid "Without mask: "
msgstr "Без маски: "

#: src/tkpostcards/scripts/tktools.py:1248
msgid ""
"Write images/ and masks/ ready for pycolmap (mask_path = masks/, "
"image_path = images/)"
msgstr ""
"Записати images/ та masks/, готові для pycolmap (mask_path = masks/, "
"image_path = images/)"

#: src/tkpostcards/scripts/tktools.py:1256
msgid "Output directory (images/ and masks/ are created in it)"
msgstr "Вихідний каталог (в ньому створюються images/ і masks/)"

#: src/tkpostcards/scripts/tktools.py:1258
msgid "Longest side of the exported images, in pixels"
msgstr "Довша сторона експортованих зображень, у пікселях"

#: src/tkpostcards/scripts/tktools.py:1264
msgid "Export"
msgstr "Експорт"

#: src/tkpostcards/scripts/tktools.py:1272
#, python-brace-format
msgid "{n} cards exported to {d}"
msgstr "{n} листівок експортовано до {d}"

#: src/tkpostcards/scripts/tktools.py:1274
msgid "Image not found: "
msgstr "Зображення не знайдено: "

#: src/tkpostcards/scripts/tktools.py:1277
msgid "Delcampe tools (website, no paid API account needed)"
msgstr "Інструменти Delcampe (вебсайт, платний обліковий запис API не потрібен)"

#: src/tkpostcards/scripts/tktools.py:1283
msgid ""
"Watched items grouped by seller, with time left and the seller's payment "
"methods. Uses the session cookie of your browser ([delcampe] cookie / "
"cookie_file in postcards.conf, or $DELCAMPE_COOKIE)."
msgstr ""
"Відстежувані лоти, згруповані за продавцями, із часом, що залишився, та "
"способами оплати продавця. Використовує cookie сесії вашого браузера "
"([delcampe] cookie / cookie_file у postcards.conf або $DELCAMPE_COOKIE)."

#: src/tkpostcards/scripts/tktools.py:1288
msgid "Which watched items to list"
msgstr "Які відстежувані лоти показувати"

#: src/tkpostcards/scripts/tktools.py:1291
msgid "Sellers order: soonest ending item, name, or number of items"
msgstr ""
"Порядок продавців: за найближчим завершенням лота, за назвою або за "
"кількістю лотів"

#: src/tkpostcards/scripts/tktools.py:1293
msgid "Output format"
msgstr "Формат виводу"

#: src/tkpostcards/scripts/tktools.py:1295
msgid "Do not look up payment methods (a single request in total)"
msgstr "Не шукати способи оплати (усього один запит)"

#: src/tkpostcards/scripts/tktools.py:1297
msgid "Ignore the seller cache and look payment methods up again"
msgstr "Ігнорувати кеш продавців і знову шукати способи оплати"

#: src/tkpostcards/scripts/tktools.py:1299
msgid "Stop after this many pages of the list"
msgstr "Зупинитися після такої кількості сторінок списку"

#: src/tkpostcards/scripts/tktools.py:1301
msgid "Seconds between two requests (default [delcampe] delay, 1.0)"
msgstr "Секунд між двома запитами (за замовчуванням [delcampe] delay, 1.0)"

#: src/tkpostcards/scripts/tktools.py:1303
msgid "Session cookie header copied from your browser"
msgstr "Заголовок cookie сесії, скопійований з вашого браузера"

#: src/tkpostcards/scripts/tktools.py:1305
msgid "Write the result to this file instead of stdout"
msgstr "Записати результат у цей файл замість stdout"

#: src/tkpostcards/scripts/tktools.py:1313
#, python-brace-format
msgid "Missing dependency ({e}). Install: pip install requests beautifulsoup4"
msgstr "Бракує залежності ({e}). Встановіть: pip install requests beautifulsoup4"

#: src/tkpostcards/scripts/tktools.py:1323
msgid ""
"No session cookie. In your browser, logged in to Delcampe, open the "
"developer tools > Network, click any delcampe.net request and copy its "
"'Cookie' header, then either put it in postcards.conf ([delcampe] cookie "
"= ...), or export DELCAMPE_COOKIE, or pass --cookie. It works like a "
"password: keep it private."
msgstr ""
"Немає cookie сесії. У браузері, де ви ввійшли в Delcampe, відкрийте "
"інструменти розробника > Мережа, клацніть будь-який запит до delcampe.net"
" і скопіюйте його заголовок «Cookie», потім або вставте його в "
"postcards.conf ([delcampe] cookie = ...), або експортуйте "
"DELCAMPE_COOKIE, або передайте --cookie. Він працює як пароль: тримайте "
"його в таємниці."

#: src/tkpostcards/scripts/tktools.py:1340
#, python-brace-format
msgid "Page {p}/{n}: {g} item(s) so far"
msgstr "Сторінка {p}/{n}: поки що лотів — {g}"

