# ==============================================================================
# postcards.conf.example
#
# Fichier de configuration d'exemple pour flpostcards, généré à partir du
# code (flpostcards/__init__.py::load_config, et les blueprints contact,
# privacy, push, api). Copier ce fichier en "postcards.conf" à la racine
# du projet (ou l'emplacement passé à create_app()/--config) puis adapter
# les valeurs à votre déploiement.
#
# Format : configparser (ini). Les commentaires "#" ou ";" en fin de ligne
# sont ignorés (inline_comment_prefixes=("#", ";")).
#
# Sections :
#   [DEFAULT]     - toujours lue, quelques clés dédiées + héritée par [flask]
#   [flask]       - configuration de l'application web (toutes les clés non
#                   listées explicitement dans load_config() sont quand même
#                   reprises telles quelles, en MAJUSCULES, dans app.config)
#   [push]        - notifications push (optionnelle)
#   [app_version] - gouvernance de version de l'appli mobile (optionnelle)
# ==============================================================================

[DEFAULT]

# Répertoire de données : cartes (cards/), pois.json, collections.json,
# updates.json, travels.json, postcards.sqlite, postcards.pkl, ...
datadir = datadir

# Répertoire d'import des scans
importdir = import

# Répertoire de cache (icône générée par icon_generator, image statique
# OSM générée par osm_static_map pour og:image, ...). Optionnel : par
# défaut <datadir>/cache. À définir explicitement pour le rediriger
# ailleurs (autre disque, tmpfs, ...) -- ce cache n'est jamais synchronisé
# ni écrasé lors d'une publication, contrairement à postcards.sqlite.
;cachedir = datadir/cache

# Verrouillage fichier (lockfile) utilisé pour les écritures concurrentes
# dans updates.json.
lock_suffix = .lck
lock_poll_interval = 2.0
lock_timeout = 60.0


[flask]

# --- Général -----------------------------------------------------------

# Mode debug Flask (NE JAMAIS activer en production : expose la console
# Werkzeug interactive en cas d'erreur).
debug = false

# Port d'écoute du serveur de développement (flask run / run.py).
port = 5000

# Secret utilisé pour signer les access tokens JWT (flpostcards/auth.py)
# et la session Flask. OBLIGATOIRE en production : une valeur absente,
# vide ou laissée à "secret" déclenche un avertissement au démarrage.
# Générer une valeur aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key = change-me-please

# URL publique de CE serveur (informative : transmise au master dans le
# payload de /api/v1/push/notify, non utilisée pour l'authentification).
;public_url = https://mon-serveur.example.com

# Texte court utilisé pour générer une icône stylisée (favicon) si aucun
# fichier static/icon.png|jpg|jpeg n'est présent.
;icon = Ma Collection

# Vue OpenStreetMap statique (zoom/latitude/longitude) utilisée comme
# image og:image sur la page /map/.
;osm_map = 12/46.7667/4.8333

# Matomo (mesure d'audience) : site_matomo = domaine du serveur Matomo,
# id_matomo = identifiant du site Matomo (siteId), "1" par défaut.
;site_matomo = matomo.example.com
;id_matomo = 1

# --- Page d'accueil / listes -------------------------------------------

# Nombre de jours définissant les cartes "récentes" affichées en avant.
recent_days = 30

# Nombre de cartes affichées si moins de "recent_days" jours n'en fournit
# assez.
recent_fallback_count = 20

# Au-delà de ce nombre de cartes, /api/v1/news et /api/v1/slideshow
# basculent automatiquement en pagination, même sans page/per_page
# explicite dans la requête.
mobile_list_max_unpaginated = 200

# --- Formulaire de contact (SMTP) ---------------------------------------
# La page /contact/ n'est activée que si smtp_host ET contact_email sont
# tous les deux renseignés.

;contact_email = contact@example.com
;smtp_host = smtp.example.com
smtp_port = 587
;smtp_user = smtp-user
;smtp_password = smtp-password
# "starttls" (port 587, par défaut) ou "ssl" (port 465)
;smtp_security = starttls

# --- Politique de confidentialité (/privacy/, toujours active) ---------

;privacy_operator_name = Jean Dupont
;privacy_operator_contact = jean@example.com
;privacy_last_updated = 2026-07-26
;data_retention_days = 730

# --- Recherche de cartes similaires (/api/v1/similar) -------------------
# URL du service simpostcards (POST /compute_hashes) utilisé pour
# comparer une photo envoyée par l'appli mobile aux cartes existantes.

similar_server = http://simpostcards:8004
similar_default_threshold = 70.0
similar_max_results = 20
similar_timeout_s = 30.0

# --- Auth JWT (flpostcards/auth.py) -------------------------------------

# Durée de vie de l'access token (secondes). 15 minutes par défaut.
jwt_access_ttl_s = 900
# Durée de vie du refresh token (secondes). 30 jours par défaut.
jwt_refresh_ttl_s = 2592000

# --- Cache HTTP des images de cartes -------------------------------------

# Cache-Control max-age (secondes) envoyé pour les images de cartes
# postales (immuables une fois publiées). 30 jours par défaut ; 0 pour
# désactiver et revenir au comportement sans Cache-Control explicite.
image_cache_max_age_s = 2592000

# --- Reverse proxy / rate limiting ---------------------------------------

# Nombre de reverse proxies "de confiance" en amont de flpostcards
# (ex : BunkerWeb = 1), pour ProxyFix / X-Forwarded-*.
trusted_proxies = 1

# Backend de comptage du rate limiting (flask-limiter). "memory://" par
# défaut (suffisant en dev ou avec un seul worker). En production avec
# plusieurs workers/instances, utiliser Redis (nécessite le paquet
# Python "redis") :
;rate_limit_storage_uri = redis://localhost:6379/0
rate_limit_storage_uri = memory://

# Préfixe des clés de rate limiting : indispensable si plusieurs serveurs
# flpostcards distincts partagent la même instance Redis, pour ne pas
# mélanger leurs compteurs.
;rate_limit_key_prefix = mon-site

# --- Themes --------------------------------------------------------------

# nom du thème ; vide = aucun thème
theme = mon_theme
# optionnel, défaut "themes" (dossier externe, relatif au dossier de travail)
themesdir = themes


[push]
# Notifications push : ce serveur ne fait que relayer au master
# centralisé (kartotek.eu), qui gère le registre des tokens et l'envoi
# FCM/APNs. Section optionnelle ; sans elle (ou avec enabled=false), la
# détection tourne quand même mais n'appelle jamais le master.

enabled = false
;master_url = https://kartotek.eu
;notify_secret = <même valeur que [push] notify_secret côté master>
watch_interval_s = 120
http_timeout_s = 10


[app_version]
# Gouvernance de version pour le client mobile (voir
# /api/v1/capabilities). Section optionnelle ; sans elle, aucune version
# minimale n'est imposée.

;api_version = 1.3
;min_supported_client = 1.0.0
;recommended_client = 1.4.0
;force_update_required = false
;force_update_reason =
;store_url_ios = https://apps.apple.com/app/idXXXXXXXXX
;store_url_android = https://play.google.com/store/apps/details?id=eu.kartotek.mobile
