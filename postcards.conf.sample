# ==============================================================================
# postcards.conf
#
# Complete configuration file for the KartoTek suite: flpostcards (web
# server), tkpostcards / tkmanager-tkscan-tkimport (desktop GUI, "KartoTek
# App"), simpostcards (hash-computation micro-service), and the shared
# remotesync publishing library.
#
# This file was reconstructed by reading every source module that parses
# it (configparser.ConfigParser, format: ini). All components share the
# SAME file (pass --conffile / --config to point elsewhere), each reading
# only the section(s) it cares about, plus [DEFAULT] which every section
# inherits automatically.
#
# Copy this file to "postcards.conf" at the root of your working
# directory (or the location passed via --conffile / create_app()'s
# config_path) and adjust the values for your deployment. Lines starting
# with "#" or ";" are comments; a commented-out "key = value" line shows
# the built-in default and can be uncommented and edited to override it.
#
# Sections:
#   [DEFAULT]      - always read, inherited by every other section below
#   [flask]        - flpostcards web app (any key not explicitly handled
#                    in load_config() is still copied as-is, uppercased,
#                    into app.config)
#   [push]         - flpostcards push notifications relay (optional)
#   [app_version]  - flpostcards mobile client version governance (optional)
#   [simpostcards] - simpostcards hash micro-service (optional; has its
#                    own sensible defaults)
#   [tkmanager]    - tkmanager (KartoTek App) desktop GUI settings
#   [tkimport]     - tkimport / tktools OCR settings
#   [sync_default] - remotesync target used by tkmanager's "publish on
#                    quit" feature (name matched by [tkmanager]
#                    publish_section below; add more such sections for
#                    additional remote targets)
# ==============================================================================

[DEFAULT]

# Data directory: postcard images (size_div1/3/10/20 subfolders),
# pois.json, collections.json, updates.json, travels.json,
# postcards.sqlite, postcards.pkl, verification/, ...
datadir = datadir

# Cache directory (icon generated by icon_generator.py, static OSM map
# image generated by osm_static_map.py for og:image, ...). Optional:
# defaults to <datadir>/cache. Set explicitly to redirect it elsewhere
# (a different disk, tmpfs, ...) -- this cache is never synced nor
# overwritten by a publish, unlike postcards.sqlite.
;cachedir = datadir/cache

# tkpostcards only: directory scanned images are imported from, and
# scratch/temporary directory used during scan/import/OCR processing.
;importdir = import
;tmpdir = tmp

# tkpostcards only: image file format used for freshly scanned masters
# (before export/resize). "tiff" by default (lossless).
;file_format = tiff

# File locking (lockfile) used for concurrent writes to updates.json,
# both by flpostcards (API writes) and by remotesync (fetch_locked).
lock_suffix = .lck
lock_poll_interval = 2.0
lock_timeout = 60.0

# Postcard back-side (verso) display: photo of the back on the card
# detail page, and recto/verso/recto+verso toggle in the gallery. Set
# to "false" to disable the verso everywhere in the app: card detail
# page loses the image and the toggle button; gallery keeps only the
# recto view, the display-mode selector disappears.
postcards_verso = true


[flask]

# --- General -------------------------------------------------------------

# Flask debug mode (NEVER enable in production: exposes the interactive
# Werkzeug console on unhandled errors).
debug = false

# Listening port for the development server (flask run / run.py).
port = 5000

# Secret used to sign JWT access tokens (flpostcards/auth.py) and the
# Flask session. REQUIRED in production: a missing, empty, or literal
# "secret" value triggers a startup warning, and anything under 32
# characters triggers a "too short for HMAC-SHA256" warning. Generate a
# random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key = change-me-please

# Public URL of THIS server. Stored both verbatim (as PUBLIC_URL, unused
# elsewhere) and as SERVER_PUBLIC_URL, which is sent to the master in the
# payload of /api/v1/push/notify -- informative only, NOT used for
# authentication (that relies on [push] notify_secret).
;public_url = https://your-server.example.com

# Short text used to generate a stylised icon (favicon) if no
# static/icon.png|jpg|jpeg file is present.
;icon = My Collection

# Static OpenStreetMap view (zoom/latitude/longitude) used as the
# og:image on the /map/ page.
;osm_map = 12/46.7667/4.8333

# Matomo (audience tracking): site_matomo = Matomo server domain,
# id_matomo = Matomo site id ("1" by default).
;site_matomo = matomo.example.com
;id_matomo = 1

# --- Home page / listings -------------------------------------------------

# Number of days defining "recent" postcards featured on the home page.
recent_days = 30

# Number of postcards shown if fewer than "recent_days" days worth exist.
recent_fallback_count = 20

# Beyond this many postcards, /api/v1/news and /api/v1/slideshow switch
# automatically to pagination, even without an explicit page/per_page in
# the request.
mobile_list_max_unpaginated = 200

# --- Contact form (SMTP) --------------------------------------------------
# The /contact/ page is only enabled if smtp_host AND contact_email are
# both set.

;contact_email = contact@example.com
;smtp_host = smtp.example.com
smtp_port = 587
;smtp_user = smtp-user
;smtp_password = smtp-password
# "starttls" (port 587, default) or "ssl" (port 465)
;smtp_security = starttls

# --- Privacy policy (/privacy/, always active) ----------------------------

;privacy_operator_name = John Doe
;privacy_operator_contact = john@example.com
;privacy_last_updated = 2026-07-26
;data_retention_days = 730

# --- Similar-postcard search (/api/v1/similar) ----------------------------
# URL of the simpostcards service (POST /api/compute_hashes) used to
# compare a photo sent by the mobile app against existing postcards.

similar_server = http://simpostcards:8004
similar_default_threshold = 70.0
similar_max_results = 20
similar_timeout_s = 30.0

# --- JWT auth (flpostcards/auth.py) ---------------------------------------

# Access token lifetime (seconds). 15 minutes by default.
jwt_access_ttl_s = 900
# Refresh token lifetime (seconds). 30 days by default.
jwt_refresh_ttl_s = 2592000

# --- HTTP cache for postcard images ----------------------------------------

# Cache-Control max-age (seconds) sent for postcard images (immutable
# once published). 30 days by default; 0 disables it (no explicit
# Cache-Control header sent).
image_cache_max_age_s = 2592000

# --- Reverse proxy / rate limiting -----------------------------------------

# Number of "trusted" reverse proxies in front of flpostcards
# (e.g. BunkerWeb = 1), for ProxyFix / X-Forwarded-*. Determines how
# many comma-separated values (counting from the right) are trusted in
# headers like X-Forwarded-Proto/X-Forwarded-For. A value set too high
# would let a client-forged X-Forwarded-* header be trusted.
trusted_proxies = 1

# Counter backend for rate limiting (flask-limiter). "memory://" by
# default (fine for dev or a single worker -- each gunicorn worker then
# has its own in-memory counters, effectively multiplying the real
# limit by the worker count). In production with several
# workers/instances, use Redis (requires the Python "redis" package):
;rate_limit_storage_uri = redis://localhost:6379/0
rate_limit_storage_uri = memory://

# Rate-limit key prefix: required if several distinct flpostcards
# servers (several KartoTek sites) share the same Redis instance --
# without a distinct prefix per server, their counters would mix (e.g.
# an attacker blocked on server A would also exhaust server B's quota).
;rate_limit_key_prefix = my-site

# --- Themes ------------------------------------------------------------

# Theme name; empty = no theme (core templates/static only).
theme = my_theme
# Optional, default "themes" (external folder, relative to the working
# directory, same as postcards.conf).
themesdir = themes


[push]
# Push notifications: this server only relays to the centralised master
# (kartotek.eu), which owns the token registry and the actual FCM/APNs
# send. Optional section; without it (or with enabled=false), detection
# still runs but the master is never called.

enabled = false
;master_url = https://kartotek.eu
;notify_secret = <must match the [push] notify_secret on the master side>
watch_interval_s = 120
http_timeout_s = 10


[app_version]
# Version governance for the mobile client (see /api/v1/capabilities).
# Optional section; without it, no minimum version is enforced.

;api_version = 1.3
;min_supported_client = 1.0.0
;recommended_client = 1.4.0
;force_update_required = false
;force_update_reason =
;store_url_ios = https://apps.apple.com/app/idXXXXXXXXX
;store_url_android = https://play.google.com/store/apps/details?id=eu.kartotek.mobile


[simpostcards]
# Standalone Flask micro-service: given a scanned postcard photo, it
# straightens/crops it and returns its perceptual hashes (used by
# flpostcards' /api/v1/similar and by tkpostcards' duplicate search).
# Stores no data; independent of datadir. Deploy it separately (its own
# postcards.conf copy is fine, only this section + [DEFAULT] matter).

debug = false
host = 127.0.0.1
port = 8002
;secret_key = change-me-please
# Any key not listed above is copied as-is, uppercased, into app.config
# (e.g. a custom "foo = bar" becomes app.config["FOO"]).

# White-pixel threshold (0-255) used by the scan straightening/cropping
# algorithm to detect the postcard's edges against the scanner background.
white_threshold = 240

# Max upload size, in MB, for an incoming scan (25 MB by default: ample
# for an uncompressed TIFF scan while avoiding an abusive request eating
# too much memory/CPU).
max_content_length_mb = 25


[tkmanager]
# Desktop GUI (KartoTek App / tkmanager.py) settings.

# Subfolders of datadir used for the full-resolution image shown in the
# card editor, and for gallery thumbnails.
images_dir = size_div1
gallery_images_dir = size_div3

# Name of the remotesync section (see [sync_default] below) used when
# publishing on quit. Override if your remote credentials live under a
# differently named section.
publish_section = sync_default

# Google Maps API key, used by the POI/address map picker (tkpostcards
# libs/mapview.py). Leave empty to disable map-based POI lookup.
;google_maps_api_key = your-google-maps-api-key

# Default similar-postcard search parameters (search dialog).
search_threshold = 70
search_max_results = 20

# Default duplicate-detection threshold (doubles search).
doubles_threshold = 90

# The following keys are written back automatically by tkmanager itself
# (window position/size, last card id/filter viewed, "publish full" tick
# state) -- no need to set them by hand, listed here only so their
# presence in a saved postcards.conf isn't a surprise:
;window_geometry =
;last_id =
;last_filter =
;publish_full = 0


[tkimport]
# OCR language(s) passed to the recognition engine when importing scans
# (tesseract-style language codes, e.g. "fra", "fra+eng"). "fra" by
# default.
ocr_langs = fra


[sync_default]
# Remote publishing target (tkpostcards/libs/remotesync.py), used by
# tkmanager's "publish on quit" feature (see [tkmanager] publish_section
# above) and by the "kartotek publish" CLI. Add further sections with a
# different name (and point publish_section / --config at them) to
# manage several remote targets (e.g. a staging vs. a production site).

# "ftp", "ftps" (implicit TLS, port 990), "ftptls" (explicit TLS,
# port 21), or "sftp" (SSH, port 22).
protocol = sftp
host = your-server.example.com
# Defaults to the protocol's standard port if omitted (21/990/21/22).
;port = 22
username = your-username
;password = your-password
# For SFTP, prefer a private key over a password.
;ssh_key_path = /home/you/.ssh/id_ed25519
remote_base_dir = /

# FTP passive mode (ignored for SFTP).
passive_mode = true
# Enable transport compression (SFTP/SSH only).
compression = true

timeout = 30

# Delete remote files that no longer exist locally during a sync.
# Handle with care: a wrong local datadir would delete remote data.
delete_orphans = false

# Simulate the sync without actually transferring/deleting anything.
dry_run = false

# Directory where sync session logs are stored. Empty = no session log
# file (console/log output only). Usually set once in [DEFAULT] so it's
# shared by every remotesync section.
;logdir =

# Number of simultaneous transfers during a directory sync.
max_workers = 5

# File-locking settings for fetch_locked() (e.g. updates.json merge
# during publish). Same meaning as [DEFAULT] lock_suffix/lock_poll_interval/
# lock_timeout above; only needed here if this section should use
# different values than [DEFAULT].
;lock_suffix = .lck
;lock_poll_interval = 2.0
;lock_timeout = 60.0
