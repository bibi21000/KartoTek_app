# ==============================================================================
# postcards.conf
#
# Complete configuration file for the KartoTek suite: flpostcards (web
# server), tkpostcards / tkmanager-tkscan-tkimport (desktop GUI, "KartoTek
# App"), simpostcards (hash-computation micro-service), and the shared
# remotesync publishing library.
#
# This file was reconstructed by reading every source module that parses
# it (configparser.ConfigParser, format: ini). All components share the
# SAME file (pass --conffile / --config to point elsewhere), each reading
# only the section(s) it cares about, plus [DEFAULT] which every section
# inherits automatically.
#
# Copy this file to "postcards.conf" at the root of your working
# directory (or the location passed via --conffile / create_app()'s
# config_path) and adjust the values for your deployment. Lines starting
# with "#" or ";" are comments; a commented-out "key = value" line shows
# the built-in default and can be uncommented and edited to override it.
#
# Sections:
#   [DEFAULT]      - always read, inherited by every other section below
#   [flask]        - flpostcards web app (any key not explicitly handled
#                    in load_config() is still copied as-is, uppercased,
#                    into app.config)
#   [redis]        - single Redis server shared by [flask]'s rate limiting
#                    and JSON cache (optional; both fall back to
#                    local-to-worker storage without it)
#   [push]         - flpostcards push notifications relay (optional)
#   [app_version]  - flpostcards mobile client version governance (optional)
#   [simpostcards] - simpostcards hash micro-service (optional; has its
#                    own sensible defaults)
#   [tkmanager]    - tkmanager (KartoTek App) desktop GUI settings
#   [tkimport]     - tkimport / tktools OCR settings
#   [sync_default] - remotesync target used by tkmanager's "publish on
#                    quit" feature (name matched by [tkmanager]
#                    publish_section below; add more such sections for
#                    additional remote targets)
# ==============================================================================

[DEFAULT]

# Data directory: postcard images (size_div1/3/10/20 subfolders),
# pois.json, links.json, collections.json, updates.json, travels.json,
# postcards.sqlite, postcards.pkl, verification/, ...
datadir = datadir

# Cache directory (icon generated by icon_generator.py, static OSM map
# image generated by osm_static_map.py for og:image, ...). Optional:
# defaults to <datadir>/cache. Set explicitly to redirect it elsewhere
# (a different disk, tmpfs, ...) -- this cache is never synced nor
# overwritten by a publish, unlike postcards.sqlite.
;cachedir = datadir/cache

# tkpostcards only: directory scanned images are imported from, and
# scratch/temporary directory used during scan/import/OCR processing.
;importdir = import
;tmpdir = tmp

# tkpostcards only: image file format used for freshly scanned masters
# (before export/resize). "tiff" by default (lossless).
;file_format = tiff

# File locking (lockfile) used for concurrent writes to updates.json,
# both by flpostcards (API writes) and by remotesync (fetch_locked).
lock_suffix = .lck
lock_poll_interval = 2.0
lock_timeout = 60.0

# Postcard back-side (verso) display: photo of the back on the card
# detail page, and recto/verso/recto+verso toggle in the gallery. Set
# to "false" to disable the verso everywhere in the app: card detail
# page loses the image and the toggle button; gallery keeps only the
# recto view, the display-mode selector disappears.
# postcards_verso = true

# Torch device used for image-similarity search (tkmanager's "Search
# similar" / "Find missing doubles" and tktools' `similar`/`doubles`/
# `missing-doubles` commands): e.g. "cuda", "cuda:0", "mps", "cpu". Run
# "tktools devices" to list what's actually available on this machine.
# Leave unset to let torch pick automatically (cuda if available, else
# cpu).
;torch_device =

# tkmanager / tktools only: URI of a remote simpostcards server (see
# [simpostcards] below) used to delegate, instead of a local
# computation, whatever simpostcards can do in place of this machine:
#
# - similarity/doubles search and index building ("Search similar" /
#   "Find missing doubles" menu items, `similar`/`doubles`/
#   `missing-doubles` tktools commands): computes perceptual hashes
#   (and, if that server has CLIP enabled -- see [simpostcards]
#   clip_enabled -- the CLIP embedding too). Lets these run without
#   torch, open-clip-torch, or imagehash installed on THIS machine.
#   If the simpostcards server does NOT have CLIP available (libs not
#   installed there, or clip_enabled=false), results fall back to
#   hash-only similarity -- still effective at finding an actual
#   duplicate scan, just less able to match a postcard photographed
#   under very different lighting/framing than the reference scan.
#   The duplicate search itself (comparing every pair of cards in the
#   index, O(n^2) -- `tktools duplicates`, "Find missing doubles") also
#   runs on that server (POST /api/find_duplicates): the index (hashes
#   + embeddings, gzip-compressed) is sent in a single request, and only
#   the matching pairs come back, streamed block by block as they are
#   computed (tkmanager displays duplicates progressively). For a
#   large collection, raise
#   [simpostcards] max_content_length_mb and external_helper_timeout
#   below. A simpostcards server too old to have this route makes the
#   client fall back to the local comparison automatically.
#
# - travel-route optimization (tkmanager's "Publish" dialog "update
#   travel routes" checkbox, `travels` / `publish --full` tktools
#   commands): computes the optimized route via OR-Tools. Lets these
#   run without ortools installed on THIS machine. If the simpostcards
#   server does NOT have route computation available (ortools not
#   installed there, or [simpostcards] travel_enabled=false), the
#   request simply fails -- no degraded fallback is possible for this
#   one, unlike the hash-only similarity fallback above: there is no
#   meaningful "partial" travel route.
#
# - OCR text extraction ("add" and "ocr" tktools commands, tkimport's
#   "Add to collection" step): runs Tesseract OCR on a postcard's
#   recto/verso. Lets these run without pytesseract (and the
#   tesseract-ocr binary) installed on THIS machine -- OCR stays
#   best-effort either way: silently skipped if neither pytesseract is
#   installed locally NOR this is set.
#
# - content detection ("add" tktools command, tkimport's "Add to
#   collection" step): generates a caption (BLIP) and/or detects
#   objects (DETR) on a postcard's recto. Lets this run without
#   transformers/torch installed on THIS machine -- stays best-effort
#   either way, like OCR above. Translation of the caption/object
#   labels (deep_translator) always runs locally regardless, on either
#   side of this setting: it doesn't need torch.
#
# - scan correction (tkimport/tktools "Analyze and correct scans" --
#   step 1 of the import workflow): straightens/crops a raw scan and,
#   unless the active profile skips it, makes its background
#   transparent. Lets this run without cv2/numpy/
#   libpostcards.contour_utils installed on THIS machine. Unlike the
#   other capabilities above, there is no "libs not installed"
#   fallback case for this one on either side: cv2/numpy are a core
#   dependency of tkpostcards/simpostcards, not an optional extra (see
#   [simpostcards] correct_scan_enabled below for the one way to
#   disable it server-side regardless). A profile with "no processing
#   at all" (the "null" built-in profile) never makes a network call
#   either way -- there's nothing to correct, so nothing to delegate.
#
# A single setting for all five, since in practice it is always the
# same simpostcards deployment. Each capability is enabled locally as
# soon as EITHER its own libs are installed here OR this is set.
# Unrelated to [flask] similar_server below, which is flpostcards' own
# (server-side, always-remote, unconditional) use of simpostcards for
# the mobile app -- a different setting for a different purpose.
;external_helper = http://simpostcards:8004

# Timeout, in seconds, for a single request to external_helper, before
# giving up client-side. Each capability has its own reasonable
# built-in default (30s for similarity/OCR, 60s for travel/detection)
# used when this is unset. Raise it if the simpostcards server is
# amended to fall back to cpu for a computation normally done on GPU
# (see [simpostcards] clip_device below, and the "GPU cassé/non
# supporté" note in simpostcards.libs.embedder): CLIP inference on cpu
# can easily exceed the default 30s per image, especially with several
# postcards queued back to back.
#
# IMPORTANT: this timeout only controls how long the CLIENT waits for
# a reply -- it does NOT cancel the computation already running on the
# simpostcards server when it fires. A client that gives up after a
# timeout does not stop a stuck/slow GPU computation server-side; if
# you see the server's GPU pegged at 100% after a client-side timeout,
# that's a separate, server-side problem (a hung ROCm/CUDA kernel after
# a prior driver-level failure is a known cause -- often only fixable
# by restarting the simpostcards container/process) -- see gunicorn's
# own --timeout option below, in [simpostcards], to have gunicorn kill
# and restart a worker stuck for too long, as a safety net.
;external_helper_timeout = 30

[flask]

# --- General -------------------------------------------------------------

# Flask debug mode (NEVER enable in production: exposes the interactive
# Werkzeug console on unhandled errors).
debug = false

# Listening port for the development server (flask run / run.py).
port = 5000

# Secret used to sign JWT access tokens (flpostcards/auth.py) and the
# Flask session. REQUIRED in production: a missing, empty, or literal
# "secret" value triggers a startup warning, and anything under 32
# characters triggers a "too short for HMAC-SHA256" warning. Generate a
# random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key = change-me-please

# Shared token protecting POST /api/v1/admin/restart, which makes this
# worker restart (full reload: this config file, collections.json,
# active theme, ...). Called automatically at the end of a publish via
# [sync_default] restart_url/restart_token below (see
# tkpostcards/libs/publish.py). Leave empty/commented to disable the
# endpoint (404). Generate a random value the same way as secret_key.
;restart_token = change-me-please

# --- File reception for publishing (sync blueprint) ------------------------
# Lets a client publish its collection to THIS server with
# "protocol = https" in its [sync_default] (see tkpostcards/libs/
# remotesync.py). Files are written straight into [DEFAULT] datadir, and the
# web app can be restarted through the same channel once the transfer is
# done. DISABLED by default: this is a WRITE entry point.
#
# Two ways in: the LAN straight to this server (plain HTTP is fine on a
# trusted network), and the Internet through TLS (nginx -> gateway ->
# here). The token is sent with every request, so never expose plain HTTP
# to the Internet. As this is also the public website, make the reverse
# proxy in front of it let only the gateway (or the LAN) reach
# sync_url_prefix; trusted_proxies (below) must match the number of proxies
# in front, since failed tokens are throttled per client IP (10/min).
# Gateway: let GET/POST/PUT/DELETE through, keep Content-Length, allow
# bodies of at least sync_max_body_mb (nginx: client_max_body_size, 1 MB by
# default -- or set max_request_mb on the client) and give POST
# <sync_url_prefix>/restart a stricter access level than the rest.
;sync_enabled = false
# REQUIRED when enabled (16+ chars; the server refuses to start otherwise):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
;sync_token = change-me-please
;sync_url_prefix = /api/v1/sync
# Largest request body accepted by the sync endpoints, in MB. The client
# adapts its batch/part sizes to it automatically.
;sync_max_body_mb = 32
# Never read, written, deleted nor listed (so never taken for "orphans" by
# a publish): refresh_tokens.sqlite* (user sessions), push_watch_state.json,
# indexnow_watch_state.json and the cache directory are ALWAYS protected.
# Comma-separated fnmatch patterns on the first path component add to them.
;sync_protected = 
# Allow the client to restart the web app (restart_remote = true in its
# [sync_default]). Under gunicorn, the master gets SIGHUP: every worker is
# replaced progressively, with no downtime (with --preload, gunicorn does not
# re-run the app code on HUP, so this config is not re-read). Without
# gunicorn, this worker gets SIGTERM and your supervisor (Docker, systemd)
# must start it again. The JSON cache is purged either way. false = 501.
;sync_allow_restart = true

# Public URL of THIS server. Stored both verbatim (as PUBLIC_URL, unused
# elsewhere) and as SERVER_PUBLIC_URL, which is sent to the master in the
# payload of /api/v1/push/notify -- informative only, NOT used for
# authentication (that relies on [push] notify_secret).
;public_url = https://your-server.example.com

# Short text used to generate a stylised icon (favicon) if no
# static/icon.png|jpg|jpeg file is present.
;icon = My Collection

# Static OpenStreetMap view (zoom/latitude/longitude) used as the
# og:image on the /map/ page.
;osm_map = 12/46.7667/4.8333

# Matomo (audience tracking): site_matomo = Matomo server domain,
# id_matomo = Matomo site id ("1" by default).
;site_matomo = matomo.example.com
;id_matomo = 1

# --- Home page / listings -------------------------------------------------

# Number of days defining "recent" postcards featured on the home page.
recent_days = 30

# Number of postcards shown if fewer than "recent_days" days worth exist.
recent_fallback_count = 20

# Beyond this many postcards, /api/v1/news and /api/v1/slideshow switch
# automatically to pagination, even without an explicit page/per_page in
# the request.
mobile_list_max_unpaginated = 200

# --- Contact form (SMTP) --------------------------------------------------
# The /contact/ page is only enabled if smtp_host AND contact_email are
# both set.

;contact_email = contact@example.com
;smtp_host = smtp.example.com
smtp_port = 587
;smtp_user = smtp-user
;smtp_password = smtp-password
# "starttls" (port 587, default) or "ssl" (port 465)
;smtp_security = starttls

# --- Privacy policy (/privacy/, always active) ----------------------------

;privacy_operator_name = John Doe
;privacy_operator_contact = john@example.com
;privacy_last_updated = 2026-07-26
;data_retention_days = 730

# --- Similar-postcard search (/api/v1/similar) ----------------------------
# URL of the simpostcards service (POST /api/compute_hashes) used to
# compare a photo sent by the mobile app against existing postcards.

similar_server = http://simpostcards:8004
similar_default_threshold = 70.0
similar_max_results = 20
similar_timeout_s = 30.0

# --- JWT auth (flpostcards/auth.py) ---------------------------------------

# Access token lifetime (seconds). 15 minutes by default.
jwt_access_ttl_s = 900
# Refresh token lifetime (seconds). 30 days by default.
jwt_refresh_ttl_s = 2592000

# --- HTTP cache for postcard images ----------------------------------------

# Cache-Control max-age (seconds) sent for postcard images (immutable
# once published). 30 days by default; 0 disables it (no explicit
# Cache-Control header sent).
image_cache_max_age_s = 2592000

# --- Reverse proxy / rate limiting -----------------------------------------

# Number of "trusted" reverse proxies in front of flpostcards
# (e.g. BunkerWeb = 1), for ProxyFix / X-Forwarded-*. Determines how
# many comma-separated values (counting from the right) are trusted in
# headers like X-Forwarded-Proto/X-Forwarded-For. A value set too high
# would let a client-forged X-Forwarded-* header be trusted.
trusted_proxies = 1

# Rate limiting (flask-limiter) and the JSON cache (collections/pois/
# travels, see json_cache_ttl_s below) both use the single Redis
# server configured in [redis] below -- no per-feature URL here
# anymore. Without [redis] url set, both fall back to local-to-worker
# storage (memory:// / SimpleCache): fine for dev or a single worker,
# but each gunicorn worker then keeps its own counters/cache -- see
# the startup warnings if that applies in production.

# Duration (seconds) the JSON cache (flpostcards/data_cache.py) keeps
# collections.json/pois.json/travels.json reads (actually SQLite reads
# synced from those files, see libpostcards.model.Model) before
# re-reading them. 15 minutes by default. Also refreshed immediately,
# for every entry, by POST /api/v1/admin/restart (see restart_token
# above).
;json_cache_ttl_s = 900

# --- Themes ------------------------------------------------------------

# Theme name; empty = no theme (core templates/static only).
theme = my_theme
# Optional, default "themes" (external folder, relative to the working
# directory, same as postcards.conf).
themesdir = themes

# IndexNow (https://www.bing.com/indexnow/getstarted): proactively tell
# participating search engines (Bing, Yandex, Seznam.cz, Naver, ...)
# about new/changed postcard pages instead of waiting for their next
# crawl. Generate a random key once, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# It is then served automatically (no file to upload) at
# https://your-server.example.com/<indexnow_key>.txt, as required by
# the API to prove you control the site -- see
# flpostcards.blueprints.home.verification_file(). Leave commented out
# to disable IndexNow entirely (flpostcards.indexnow.submit_urls()
# becomes a silent no-op).
;indexnow_key = change-me-generate-a-real-key
# How often flpostcards/indexnow_watch.py polls for new/changed cards
# and travels when run in continuous mode (see its docstring for the
# "python -m flpostcards.indexnow_watch" usage -- run it as its own
# process, not started from create_app()). 5 minutes by default.
;indexnow_watch_interval_s = 300
# HTTP timeout (seconds) for calls to the IndexNow API.
;indexnow_http_timeout_s = 10
# NOTE: indexnow_watch also requires "public_url" above to be set (it
# runs outside of any real HTTP request, so it has no Host header to
# build absolute URLs from) -- without it, each cycle is skipped with
# a warning.


[redis]
# Single Redis server shared by every optional Redis-backed feature of
# this flpostcards instance (currently: rate limiting and the JSON
# cache -- see [flask] json_cache_ttl_s above; more may use it later).
# One URL to define here instead of one per feature. Leave commented
# to keep everything local-to-worker (memory:// rate limiting,
# SimpleCache JSON cache) -- fine for dev/single-worker, see the
# startup warnings otherwise. Requires the Python "redis" package.
;url = redis://localhost:6379/0

# Global prefix, prepended to every key this flpostcards instance
# writes to the server above. Change it if several applications --
# several KartoTek sites, or an unrelated Flask app -- share the same
# Redis server: without a distinct prefix per application, their keys
# would collide (e.g. an attacker blocked on site A would also exhaust
# site B's rate-limit quota).
;prefix = kartotek

# Sub-prefixes, appended to "prefix" above, keeping rate-limit counters
# and JSON-cache entries in their own namespace within this instance.
# Rarely need changing.
;ratelimit_prefix = ratelimit
;cache_prefix = cache


[push]
# Push notifications: this server only relays to the centralised master
# (kartotek.eu), which owns the token registry and the actual FCM/APNs
# send. Optional section; without it (or with enabled=false), detection
# still runs but the master is never called.

enabled = false
;master_url = https://kartotek.eu
;notify_secret = <must match the [push] notify_secret on the master side>
watch_interval_s = 120
http_timeout_s = 10


[app_version]
# Version governance for the mobile client (see /api/v1/capabilities).
# Optional section; without it, no minimum version is enforced.

;api_version = 1.3
;min_supported_client = 1.0.0
;recommended_client = 1.4.0
;force_update_required = false
;force_update_reason =
;store_url_ios = https://apps.apple.com/app/idXXXXXXXXX
;store_url_android = https://play.google.com/store/apps/details?id=eu.kartotek.mobile


[simpostcards]
# Standalone Flask micro-service, five independent capabilities:
# - given a scanned postcard photo, straightens/crops it and returns
#   its perceptual hashes -- and, if torch/open-clip-torch are
#   installed here (see clip_enabled below), a CLIP embedding too --
#   used by flpostcards' /api/v1/similar and by tkpostcards' duplicate
#   search (see [DEFAULT] external_helper above);
# - given a raw scan and a set of profile parameters, straightens/
#   crops it and (unless asked to skip it) makes its background
#   transparent (see correct_scan_enabled below and [DEFAULT]
#   external_helper above), used by tkimport/tktools' "Analyze and
#   correct scans" step;
# - given a start point and a list of geolocated postcards, computes
#   an optimized travel route via OR-Tools (see travel_enabled below
#   and [DEFAULT] external_helper above), used by tkpostcards;
# - given a postcard image, extracts its text via Tesseract OCR (see
#   ocr_enabled below and [DEFAULT] external_helper above), used by
#   tkpostcards when adding postcards to the collection;
# - given a postcard's recto, generates a caption (BLIP) and/or
#   detects objects (DETR) (see detection_enabled below and [DEFAULT]
#   external_helper above), used by tkpostcards when adding postcards
#   to the collection.
# See gpu_idle_timeout below to automatically free GPU memory (CLIP/
# BLIP/DETR) after a period of inactivity, on a GPU shared with other
# uses.
# Stores no data; independent of datadir. Deploy it separately (its own
# postcards.conf copy is fine, only this section + [DEFAULT] matter).
#
# Deployment note -- a slow/stuck request doesn't just make the client
# wait: gunicorn's own worker is blocked for the same duration, and a
# genuinely hung GPU kernel (see the "GPU cassé/non supporté" note in
# simpostcards.libs.embedder) can leave it stuck indefinitely, with the
# GPU pegged at 100%, even after the client gives up. Nothing in this
# application can safely interrupt an already-running GPU computation
# from the outside -- the practical safety net is gunicorn's own
# --timeout option (e.g. `gunicorn --timeout 120 ...`), which kills and
# automatically restarts a worker stuck longer than that, rather than
# leaving it wedged forever. Set it comfortably above
# [DEFAULT] external_helper_timeout above (clients give up first,
# gunicorn's --timeout is the last-resort cleanup).

debug = false
host = 127.0.0.1
port = 8002
;secret_key = change-me-please
# Any key not listed above is copied as-is, uppercased, into app.config
# (e.g. a custom "foo = bar" becomes app.config["FOO"]).

# White-pixel threshold (0-255) used by the scan straightening/cropping
# algorithm to detect the postcard's edges against the scanner background.
white_threshold = 240

# Max upload size, in MB, for an incoming scan (25 MB by default: ample
# for an uncompressed TIFF scan while avoiding an abusive request eating
# too much memory/CPU).
max_content_length_mb = 25

# Scan correction (straighten/crop + background transparency, driven by
# the same parameters as a tkimport "import profile"): needs only
# cv2/numpy, which simpostcards already requires for everything else --
# so there is no "libs not installed" case here, unlike CLIP/OCR/
# detection/travel. Set to false only to disable this endpoint on a
# deployment dedicated to the other capabilities.
;correct_scan_enabled = true

# CLIP embedding (in addition to the perceptual hashes above): only
# computed if torch + open-clip-torch are installed on THIS machine,
# and this isn't set to false. When available, results returned to
# clients (see [DEFAULT] external_helper) include a full similarity
# score (hashes + CLIP), not just hash-only matching. Safe to leave at
# its default (true) on a deployment without those libs installed:
# computation is skipped automatically, "embedding" stays null in the
# response, exactly as if this were false.
;clip_enabled = true

# CLIP model to use, and the device to run it on (e.g. "cuda", "cpu").
# MUST match whatever a client comparing these embeddings itself uses
# (see PostcardSearcher(model_name=..., pretrained=...) in
# libpostcards.similar) -- comparing embeddings from two different
# models is meaningless. Leave clip_device unset to auto-detect (cuda
# if available, else cpu).
;clip_model_name = ViT-L-14
;clip_pretrained = laion2b_s32b_b82k
;clip_device =

# The first time CLIP is used, open_clip downloads its weights (~890 MB
# for the default model) from Hugging Face Hub if not already cached
# locally (~/.cache/huggingface). On a Docker container with no
# outbound network access, this fails with repeated "Connection
# refused" retries -- and, without this setting, EVERY subsequent
# compute_hashes request repeats that same failing multi-second retry
# sequence. Set clip_offline = true once the weights are already in
# the container's cache (e.g. pre-downloaded at image build time) to
# skip the network entirely: instant, clear failure if they're
# missing, instead of retrying against an unreachable server. A failed
# load is remembered for the life of the process either way (only
# attempted once, not once per request) -- restart the container to
# retry after fixing connectivity or baking in the weights.
;clip_offline = false

# Route optimization (OR-Tools): only active if ortools is installed
# here. Set to false to disable this endpoint even if ortools IS
# installed (e.g. a server dedicated to hashes/embeddings only, kept
# free of the CPU-heavy route solver).
;travel_enabled = true

# OCR: two engines, and the CLIENT chooses which one it wants for each request
# ([tkimport] ocr_engine, or "kttools ... --ocr-engine"):
#  - Tesseract: only active if pytesseract (and the tesseract-ocr binary +
#    language data, e.g. tesseract-ocr-fra) is installed here.
#  - PaddleOCR: only active if paddleocr + paddlepaddle are installed here.
#    Install the PaddlePaddle framework FIRST, for your platform (see the
#    comment of the "paddleocr" extra in pyproject.toml: PyPI has it only for
#    Python 3.9-3.13 on Linux x86_64 / macOS arm64 / Windows, CPU-only),
#    then: pip install pypostcards[paddleocr]. Better than tesseract on noisy
#    printed text and text laid over a photo (captions, publisher marks);
#    like tesseract it is NOT a handwriting reader. Its models (a few tens
#    of MB per language) are downloaded from the Internet the first time a
#    language is used, into ~/.paddlex: a server without network access
#    must have them there beforehand.
# If a client asks for a language the engine does not have, or for an engine
# that is not available here, the server logs a WARNING and tells the client
# (HTTP 422 / 501), which shows it to the user.
# Set to false to disable the OCR endpoints altogether, whatever is installed
# (e.g. a server dedicated to hashes/embeddings/travel only).
;ocr_enabled = true

# Disable the PaddleOCR engine only (tesseract stays available) even if
# paddleocr IS installed.
;paddleocr_enabled = true

# Where PaddleOCR runs on this server: "cpu", "gpu:0"... Empty = PaddlePaddle's
# own choice (the GPU if its build has CUDA). "cpu" is a good value on a
# machine whose GPU memory is wanted by something else (the PP-OCR models
# are small; a postcard takes a few seconds on CPU). Together with
# gpu_idle_timeout, which also unloads PaddleOCR when it is idle.
# NOTE for AMD GPUs: PaddlePaddle's pip wheels exist for the CPU and for NVIDIA
# CUDA only, not for AMD ROCm (that needs a build from source). With the
# standard wheel, "gpu:0" is refused with an explicit message: keep "cpu".
;paddleocr_device = cpu

# PP-OCR generation to use ("PP-OCRv5", "PP-OCRv6"...). Empty = the best one
# the installed paddleocr has for the requested language.
;paddleocr_version =

# Tesseract language used by default if a client doesn't specify one
# (rare in practice: PostcardOCR always sends its own -- see
# libpostcards.ocr).
;ocr_default_lang = fra

# Content detection (BLIP caption + DETR object detection): only
# active if transformers + torch are installed here. Set to false to
# disable this endpoint even if they ARE installed (e.g. a server
# dedicated to hashes/embeddings/travel/OCR only -- the two detection
# models together are the heaviest of the four capabilities, memory-
# wise).
;detection_enabled = true

# Models to use, and the device to run them on (e.g. "cuda", "cpu").
# Unlike CLIP/OCR, these don't need to match anything client-side:
# results (captions/object labels, always in English) are translated
# locally by the client, so the exact model used server-side is purely
# a server deployment choice. Leave detection_device unset to
# auto-detect (cuda if available, else cpu).
;detection_model_name = Salesforce/blip-image-captioning-large
;detection_objects_model_name = facebook/detr-resnet-101
;detection_device =

# SAM segmentation (POST /api/compute_segments), used by the clients' mask
# generation ("kttools masks generate", ktmanager "Masks") when they have
# [DEFAULT] external_helper set: the server only segments, the clients pick
# which segments are stamps (thresholds in their own [masks] section).
# Needs transformers + torch on this server. Same rules as detection_*:
# model and device are a server deployment choice, not a request parameter.
# gpu_idle_timeout also unloads SAM when it stays unused.
;segment_enabled = true
;segment_model_name = facebook/sam-vit-base
;segment_device =

# Translation of the detection texts (caption and object labels), done here
# when a client has external_helper set and sends its language: the "lang" of
# POST /api/compute_detection, and POST /api/translate (used by "kttools
# detect-translate" to translate texts that were stored in English). Uses
# deep_translator (an online translation service: this server needs internet
# access for it). If the language is not supported, or the translation fails,
# the server logs a WARNING and tells the client, which warns the user: the
# detection result is never lost, it just stays in English.
# The free translation service allows about 5 requests per second (and 5000
# characters per request): this server spaces its requests, groups many texts
# into one request, and waits when the service answers "too many requests". If
# the service still refuses, /api/translate answers HTTP 429 with a
# Retry-After and "kttools detect-translate" waits and retries by itself
# (what is already translated stays saved; running it again continues).
;translate_enabled = true

# Which engine translates:
#  - google (default): Google's free web service, through deep_translator.
#    It refuses this server's IP address (HTTP 429) after a burst of requests,
#    and the refusal can last minutes or hours even at one request every few
#    seconds. When that happens the server stops asking for 10 min, then 30
#    min, then 2 h (so as not to prolong it) and answers 429; "kttools
#    detect-translate" then tells you how long to wait.
#  - marian: a local model (Helsinki-NLP/opus-mt-en-<lang>, ~300 MB per
#    language, downloaded from Hugging Face on first use into HF_HOME). No rate
#    limit, works offline afterwards, the text never leaves the machine.
#    Needs: pip install pypostcards[translate-local]. Quality is that of a
#    small translation model: fine for captions, a lone ambiguous word such as
#    "tie" can be mistranslated (as with any translator given no context).
#  - auto: google first, and the local model takes over as soon as google
#    refuses this server. The recommended setting if google is sometimes
#    refused: nothing to do on the client side.
;translate_engine = google

# Where the local model runs ("cpu" by default, which leaves the GPU to other
# uses; "cuda" or "cuda:0" to use it) and the name of the model, with {lang}
# replaced by the language code ("fr", "de"...).
# On an AMD GPU with a ROCm build of torch, the device is called "cuda" (that is
# how torch names it): translate_device = cuda. For a model this small and a
# few hundred short texts, the CPU is usually just as practical.
;translate_device = cpu
;translate_marian_model = Helsinki-NLP/opus-mt-en-{lang}

# Free the memory (GPU *and* RAM) of every model this server has loaded
# (CLIP, BLIP, DETR, SAM) once it has not been used for this many seconds,
# so the machine can give it to something else -- e.g. Open WebUI/Ollama
# on the same GPU. A model is reloaded transparently (paying the load cost
# again) on the next request that needs it, and is never unloaded while a
# request is using it. 0/unset (default): never unload, matching the
# historical behaviour. A few minutes (e.g. 300-600) is a reasonable
# starting point: long enough to avoid reloading on every short pause
# between requests, short enough to give memory back promptly. The check
# runs 4 times per period, so unloading happens between 1x and 1.25x this
# delay after the last use.
# Each gunicorn worker watches (and unloads) its own models.
# To free everything right now instead of waiting:
#   curl -X POST http://host:8002/api/unload_models
;gpu_idle_timeout = 600


[delcampe]
# "kttools delcampe watchlist": your watched items grouped by seller, with the
# time left and the seller's payment methods. It reads the Delcampe website
# with YOUR browser session (no paid API account needed).
#
# Cookie: logged in to Delcampe in your browser, open the developer tools >
# Network, click any request to www.delcampe.net and copy the value of its
# "Cookie" request header. It works like a password: keep this file private
# (chmod 600). When it expires the command says so; copy a new one.
# Alternatives: the DELCAMPE_COOKIE environment variable, --cookie, or
# cookie_file = a text file holding that header, or a Netscape cookies.txt
# exported by a browser extension.
;cookie =
;cookie_file = ~/.config/postcards/delcampe-cookie.txt
# Site language of the URLs (and of the payment method names).
;lang = fr
# Seconds between two requests: the site is read one page at a time, gently.
;delay = 1.0
# If Delcampe refuses the requests (HTTP 403), send the same User-Agent as
# the browser the cookie comes from.
;user_agent = Mozilla/5.0 (X11; Linux x86_64) ...
# Payment methods are a property of the seller: they are looked up once per
# seller and kept this many days (--refresh forces a new lookup).
;cache_days = 7
;cache_file = ~/.cache/kttools/delcampe_sellers.json
;page_size = 480

[tkmanager]
# Desktop GUI (KartoTek App / tkmanager.py) settings.

# Subfolders of datadir used for the full-resolution image shown in the
# card editor, and for gallery thumbnails.
images_dir = size_div1
gallery_images_dir = size_div3

# Name of the remotesync section (see [sync_default] below) used when
# publishing on quit. Override if your remote credentials live under a
# differently named section.
publish_section = sync_default

# Google Maps API key, used by the POI/address map picker (tkpostcards
# libs/mapview.py). Leave empty to disable map-based POI lookup.
;google_maps_api_key = your-google-maps-api-key

# Default similar-postcard search parameters (search dialog).
search_threshold = 70
search_max_results = 20

# Default duplicate-detection threshold (doubles search).
doubles_threshold = 90

# The following keys are written back automatically by tkmanager itself
# (window position/size, last card id/filter viewed, "publish full" tick
# state) -- no need to set them by hand, listed here only so their
# presence in a saved postcards.conf isn't a surprise:
;window_geometry =
;last_id =
;last_filter =
;publish_full = 0


[masks]
# tkmanager (menu "Plus" > "Masques") / "kttools masks ..." : masks given to
# pycolmap so that stamps, postmarks, the transparent background and the card
# border produce no keypoints (stamps look alike from one card to another and
# create wrong matches). Needs: pip install pypostcards[masks]
# With [DEFAULT] external_helper set, SAM runs on that simpostcards server
# (see segment_enabled in [simpostcards]) and only numpy, opencv and requests
# are needed here; "kttools masks generate --local" forces a local run.
# sam_model below is then ignored: the server's segment_model_name applies.
#
# Hugging Face SAM model used to find the stamps. "facebook/sam-vit-base" is
# a good speed/quality compromise ("-large" and "-huge" are slower).
;sam_model = facebook/sam-vit-base
# Grid of SAM prompts (points per side). 32 is SAM's default; 20 is enough
# for objects as big as a stamp and about 2.5x faster on CPU.
;sam_points_per_side = 20
# Longest side, in pixels, at which masks are stored and edited.
;max_side = 1600
# Border band ignored along the edge of the card (fraction of longest side).
;border_margin = 0.004
# A stamp candidate is a SAM segment whose area is between these fractions of
# the card, which is close to a rectangle, and which touches the card edge
# zone (fraction of width/height).
;stamp_min_area = 0.004
;stamp_max_area = 0.12
;stamp_min_fill = 0.80
;stamp_edge_zone = 0.15
# Stamp masks are grown by this fraction of the longest side (perforations,
# shadow, postmark overlapping the stamp).
;stamp_dilate = 0.006
;max_stamps = 3

[tkimport]
# OCR language(s) passed to the recognition engine when importing scans
# (tesseract-style language codes, e.g. "fra", "fra+eng"). "fra" by
# default. PaddleOCR language codes ("fr", "en", "german"...) work with both
# engines. PaddleOCR reads ONE language per call: with several, the first
# one that is not English is used ("fra+eng" -> French, which reads English
# too).
ocr_langs = fra

# OCR engine, chosen here whether it runs on this machine or on the server
# (external_helper): "tesseract" (default) or "paddleocr". Also available as
# --ocr-engine on "kttools add" and "kttools ocr". If the engine, or the
# language for it, is not available where it would run, the import stops
# before copying anything, with a message saying what to install or change.
ocr_engine = tesseract

# PaddleOCR only: minimum confidence (0-1) of a text line to keep it. Lower
# keeps more text but also more noise read from textures (stone, foliage).
# Empty = 0.5.
;ocr_min_score = 0.5

# PaddleOCR only, when it runs on this machine (not on the server, whose own
# setting is paddleocr_device in [simpostcards]): "cpu", "gpu:0"... Empty =
# PaddlePaddle's choice.
;paddleocr_device =

# White-pixel threshold (0-255) used when correcting/cropping a scan
# against the scanner background, both in the tkimport GUI ("White
# threshold" spinbox on step 1, editable and saved back to this file)
# and as the default for "tktools scan prepare" / "tktools
# transparency" (each still overridable with --white-threshold).
white_threshold = 240

# Detection parameters
detect_lang = fr
model_name = Salesforce/blip-image-captioning-large
objects_model_name = facebook/detr-resnet-101
objects_threshold = 0.92
max_objects = 10
excluded_objects = cravate

[sync_default]
# Remote publishing target (tkpostcards/libs/remotesync.py), used by
# tkmanager's "publish on quit" feature (see [tkmanager] publish_section
# above) and by the "kartotek publish" CLI. Add further sections with a
# different name (and point publish_section / --config at them) to
# manage several remote targets (e.g. a staging vs. a production site).

# "ftp", "ftps" (implicit TLS, port 990), "ftptls" (explicit TLS,
# port 21), "sftp" (SSH, port 22), or "https" (port 443: posts files to the
# sync blueprint of a flpostcards server -- see "[flask] sync_*" above and
# the https options at the end of this section).
protocol = sftp
host = your-server.example.com
# Defaults to the protocol's standard port if omitted (21/990/21/22).
;port = 22
username = your-username
;password = your-password
# For SFTP, prefer a private key over a password.
;ssh_key_path = /home/you/.ssh/id_ed25519
remote_base_dir = /

# FTP passive mode (ignored for SFTP).
passive_mode = true
# Enable transport compression (SFTP/SSH only).
compression = true

timeout = 30

# Delete remote files that no longer exist locally during a sync.
# Handle with care: a wrong local datadir would delete remote data.
delete_orphans = false

# Simulate the sync without actually transferring/deleting anything.
dry_run = false

# Directory where sync session logs are stored. Empty = no session log
# file (console/log output only). Usually set once in [DEFAULT] so it's
# shared by every remotesync section.
;logdir =

# Number of simultaneous transfers during a directory sync.
max_workers = 5

# File-locking settings for fetch_locked() (e.g. updates.json merge
# during publish). Same meaning as [DEFAULT] lock_suffix/lock_poll_interval/
# lock_timeout above; only needed here if this section should use
# different values than [DEFAULT].
;lock_suffix = .lck
;lock_poll_interval = 2.0
;lock_timeout = 60.0

# Called automatically once a publish to this target has finished
# (PostcardPublish.publish(), see tkpostcards/libs/publish.py), to make
# the remote flpostcards server reread its database, collections.json,
# etc. Two mutually available mechanisms -- restart_command wins if
# both are set:
#
# restart_command (protocol = sftp only): a shell command run on the
# remote host over the SAME SSH connection already used for the file
# transfer (no separate network hop, no need to expose anything on the
# internet). It can call the API on localhost, e.g.:
#   curl -fsS -X POST -H "X-Restart-Token: <token>" http://127.0.0.1:5000/api/v1/admin/restart
# or restart a system service directly, e.g.:
#   systemctl --user restart flpostcards
# (whatever the account used for SFTP is allowed to run; a passwordless
# sudo rule may be needed for a system-wide systemctl).
;restart_command =
#
# restart_url (+ optional restart_token): a plain HTTP(S) POST request
# to POST /api/v1/admin/restart -- see [flask] restart_token above
# (NOTE: that key lives in the remote server's OWN postcards.conf, not
# necessarily this file). Works for any protocol, but requires that
# endpoint to be reachable from wherever this runs.
;restart_url = https://your-server.example.com/api/v1/admin/restart
;restart_token = change-me-please
#
# restart_remote (protocol = https only): ask the flpostcards server to
# restart its web app once the publish is complete (workers reloaded, JSON
# cache purged -- see [flask] sync_allow_restart, which lets the server
# refuse). Takes priority over restart_url if both are set. Replaces
# restart_url when you do not want to expose /api/v1/admin/restart: the sync
# endpoint is already protected by the same token as the transfer.
;restart_remote = false
#
# Leaving all of these empty (default) skips this step entirely; a
# network/SSH/HTTP failure here only logs a warning, it never fails
# the publish.

# --- protocol = https only -------------------------------------------------
# With https, "host" is a host name, or a full URL when flpostcards is
# served under a sub-path of a reverse proxy: https://example.com/postcards.
# The default port is 443; remote_base_dir is relative to the server's
# sync_base_dir ("/" = sync_base_dir itself).
#
# Two ways to reach the same server = two sections, e.g.:
#   [sync_lan]       host = http://flpostcards:5000    (direct, no TLS)
#                    allow_http = true
#   [sync_internet]  host = https://tools.example.com  (nginx + gateway)
#                    api_key = <key of level guest or above>
# Plain http:// is refused unless allow_http = true: the token then travels
# in clear, so only for a trusted local network, never over the Internet.
;allow_http = false
# API key required by a gateway in front of flpostcards (toolspostcards).
# Publishing needs the "publish" capability, granted from level "guest" up;
# restart_remote = true also needs "publish:restart" (level "gold" by default).
# Sent in api_key_header IN ADDITION to the token below, which flpostcards
# always checks itself (the gateway must forward "Authorization" untouched).
;api_key = 
;api_key_header = X-API-Key
# Largest request the proxy chain accepts, in MB (nginx: client_max_body_size,
# only 1 MB by default!). Batches and parts are sized to stay under it.
# 0 = no limit of its own (the server's sync_max_body_mb still applies).
;max_request_mb = 0
#
# Shared secret = [flask] sync_token of the server. Falls back to
# "password" if unset.
;token = change-me-please
# Path of the sync blueprint ([flask] sync_url_prefix on the server).
;url_prefix = /api/v1/sync
# Server certificate check. For a private/self-signed certificate, give it
# (or its CA) in ca_bundle rather than switching verification off.
;verify_tls = true
;ca_bundle = /home/you/.config/postcards/server.pem
# Transfer tuning. Small files are sent many per request (up to batch_mb
# megabytes / batch_files files), files bigger than part_mb are cut into
# parts sent in parallel (max_workers connections above). Both are capped
# automatically by the server's sync_max_body_mb. "compression" (above)
# also controls the zlib compression of compressible files (json, sqlite,
# pkl, text -- never JPEG).
;batch_mb = 4
;batch_files = 500
;part_mb = 8
